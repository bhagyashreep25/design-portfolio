# Copy to .env.local for local dev, and set the same values in
# Vercel → Project → Settings → Environment Variables.
#
# Neither of these is ever sent to the browser: they are read only in
# lib/gate.ts and app/api/unlock/route.ts, both server-only.

# The password recruiters type to unlock protected case studies.
# This is the one you put on your resume.
PORTFOLIO_PASSWORD=

# Random string used to sign the unlock cookie so it can't be forged.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this (or the password above) logs everyone out.
PORTFOLIO_GATE_SECRET=
